# Cogent 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
COGENT_HOST=127.0.0.1
COGENT_PORT=7437

# ── Logging ───────────────────────────────────────────────────
COGENT_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
COGENT_LOG_FILE=~/.cogent/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
COGENT_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# COGENT_CONFIG=~/.cogent/config.toml

# ── LLM ────────────────────────────────────────
# ANTHROPIC_API_KEY=...
# COGENT_LLM_DEFAULT_MODEL=...
# ANTHROPIC_BASE_URL=...
# COGENT_MAX_STEPS=20
